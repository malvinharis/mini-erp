NODE_ENV=production
PORT=3000

# Base URL of the NestJS API. Includes the `/api` global prefix.
# API_URL             -> server-side fetch (RSC)
# NEXT_PUBLIC_API_URL -> client axios; inlined into the browser bundle at BUILD time
API_URL=https://mini-erp-api.malvinharis.web.id/api
NEXT_PUBLIC_API_URL=https://mini-erp-api.malvinharis.web.id/api
